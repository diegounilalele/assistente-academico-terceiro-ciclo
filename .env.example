# Copie este arquivo para ".env" e preencha os valores.

# URL do Ollama (se não definir, usa a instalação local padrão)
ollama_url=http://localhost:11434

# Modelo usado nas respostas da IA (obrigatório)
# Obs.: o gpt-oss:20b-cloud quebrou (devolve resposta vazia; problema no
# servidor do Ollama Cloud). O 120b-cloud funciona; o qwen2.5:7b é o
# substituto local caso a nuvem caia de novo.
ollama_model=gpt-oss:120b-cloud

# Chave que assina os cookies de sessão — troque por qualquer texto secreto
SEGREDOSEGREDO=troque-este-segredo

# Expor o servidor na internet com o ngrok (true/false)
USAR_NGROK=false

# Token do agente ngrok (só é usado se USAR_NGROK=true)
ngrok_token=

# Chave da API do ngrok (opcional; serve para derrubar sessões presas)
ngrok_api_key=
